# Maintainer: brayanluc
pkgname=caelestia-clipboard-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Native QML clipboard history drawer for Caelestia Shell"
arch=('any')
url="https://github.com/brayanluc/caelestia-clipboard"
license=('MIT')
depends=('caelestia-shell' 'cliphist' 'wl-clipboard' 'python')
makedepends=('git')
provides=('caelestia-clipboard')
conflicts=('caelestia-clipboard')
source=("${pkgname}::git+https://github.com/brayanluc/caelestia-clipboard.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$srcdir/$pkgname"
    install -dm755 "$pkgdir/usr/share/caelestia-clipboard/modules"
    cp -r src/modules/clipboard "$pkgdir/usr/share/caelestia-clipboard/modules/"

    install -Dm755 aur/caelestia-clipboard-setup "$pkgdir/usr/bin/caelestia-clipboard-setup"
    install -Dm644 aur/caelestia-clipboard.service "$pkgdir/usr/lib/systemd/user/caelestia-clipboard.service"
    install -Dm644 aur/caelestia-clipboard.hook "$pkgdir/usr/share/libalpm/hooks/caelestia-clipboard.hook"

    install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
    ln -s ../caelestia-clipboard.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/caelestia-clipboard.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
